{
  "elements": [
    { "type": "Label", "label": "LG ThinQ Device Instance" },
    { "type": "ValidationTextBox", "name": "Alias", "caption": "Alias", "width": "400px" },
    { "type": "ValidationTextBox", "name": "DeviceID", "caption": "Device ID", "width": "500px", "enabled": true },
    { "type": "CheckBox", "name": "Debug", "caption": "Debug logging" }
  ],
  "actions": [
    { "type": "Button", "caption": "Update status", "onClick": "LGTQD_UpdateStatus($id);" },
    { "type": "Label", "label": "Diagnostics & support", "visible": false  },
    { "type": "Label", "label": "Note: if a device does not work correctly, you can create a diagnostic file. It only contains device-specific data; personal data such as the device ID or tokens is anonymized.", "visible": false },
    { "type": "Button", "caption": "Create support package (ZIP)", "download": "LGThinQ_Device_Support.zip", "onClick": ["echo LGTQD_UIExportSupportBundle($id);"], "visible": false  },
    { "type": "Button", "caption": "Reapply Presentations", "onClick": "LGTQD_ReapplyPresentations($id);", "visible": false },
    { "type": "Button", "caption": "Reapply Names", "confirm": "Variable names are set to the current names in the language of this Symcon. Continue?", "onClick": "echo LGTQD_ReapplyNames($id);", "visible": false },
    { "type": "Button", "caption": "1. Show cleanup preview", "onClick": ["echo LGTQD_UICleanupPreview($id);"] , "visible": false },
    { "type": "Button", "caption": "2. Clean up variables", "confirm": "Variables that are not part of the plan will be deleted. Continue?", "onClick": "echo LGTQD_CleanupVariables($id, true);", "visible": false }
  ],
  "status": [
    { "code": 101, "icon": "inactive", "caption": "Creating" },
    { "code": 102, "icon": "active", "caption": "Ready" },
    { "code": 104, "icon": "error", "caption": "Configuration incomplete" }
  ]
}
